server:
  http_listen_port: 3200

distributor:
  receivers:
    otlp:
      protocols:
        grpc:
          endpoint: 0.0.0.0:4317

storage:
  trace:
    backend: local
    local:
      path: /var/tempo/blocks
    wal:
      path: /var/tempo/wal

# Tempo 3.0 で compactor は廃止され、保持期間は backend_worker 側に移った
backend_worker:
  compaction:
    block_retention: ${retention}

usage_report:
  reporting_enabled: false
