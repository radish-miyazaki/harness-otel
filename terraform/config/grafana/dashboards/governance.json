{
  "uid": "harness-governance",
  "title": "ハーネス / ガバナンス",
  "tags": [
    "harness-otel"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 13,
      "type": "row",
      "title": "Claude Code",
      "collapsed": false,
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Claude Code bypassPermissions への遷移",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "w": 8,
        "h": 5,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum (count_over_time({service_name=\"claude-code\"} | event_name=\"permission_mode_changed\" | to_mode=\"bypassPermissions\" [$__range]))",
          "legendFormat": "件"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "colorMode": "background"
      },
      "description": "0 でなければ経緯を確認する"
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Claude Code MCP 接続失敗",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "w": 8,
        "h": 5,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum (count_over_time({service_name=\"claude-code\"} | event_name=\"mcp_server_connection\" | status=\"failed\" [$__range]))",
          "legendFormat": "件"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 16,
      "type": "gauge",
      "title": "Claude Code 編集ツール accept 率",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "w": 8,
        "h": 5,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(max_over_time(claude_code_code_edit_tool_decision_total{decision=\"accept\"}[$__range])) / sum(max_over_time(claude_code_code_edit_tool_decision_total[$__range]))",
          "legendFormat": "accept"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {},
      "description": "Edit / Write / NotebookEdit の権限判断。編集が発生するまで値は出ない"
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Claude Code 権限モード遷移",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (from_mode, to_mode) (count_over_time({service_name=\"claude-code\"} | event_name=\"permission_mode_changed\" [$__auto]))",
          "legendFormat": "{{from_mode}} → {{to_mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Claude Code ツール判断（tool_name × decision）",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (tool_name, decision) (count_over_time({service_name=\"claude-code\"} | event_name=\"tool_decision\" [$__auto]))",
          "legendFormat": "{{tool_name}} / {{decision}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Claude Code 判断の出所（source 別）",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (source) (count_over_time({service_name=\"claude-code\"} | event_name=\"tool_decision\" [$__auto]))",
          "legendFormat": "{{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "config=設定で自動許可、user_permanent / user_temporary=人が許可、user_reject / user_abort=人が拒否、hook=フックが判断"
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Claude Code MCP 接続（plugin × transport × status）",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (plugin_name, transport_type, status) (count_over_time({service_name=\"claude-code\"} | event_name=\"mcp_server_connection\" [$__auto]))",
          "legendFormat": "{{plugin_name}} {{transport_type}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 21,
      "type": "logs",
      "title": "Claude Code 読み込まれたプラグイン",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "w": 24,
        "h": 8,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"claude-code\"} | event_name=\"plugin_loaded\" | line_format \"{{.plugin_name}} {{.plugin_version}} ({{.marketplace_name}})\"",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 22,
      "type": "row",
      "title": "Codex",
      "collapsed": false,
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 30
      },
      "panels": []
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Codex 承認結果（decision × source）",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (decision, source) (count_over_time({service_name=\"codex_cli_rs\"} | event_name=\"codex.tool_decision\" [$__auto]))",
          "legendFormat": "{{decision}} / {{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "source=Config は approval_policy による自動判断、User は人が答えたもの"
    },
    {
      "id": 24,
      "type": "barchart",
      "title": "Codex 会話のポリシー（sandbox × approval）",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (sandbox_policy, approval_policy) (count_over_time({service_name=\"codex_cli_rs\"} | event_name=\"codex.conversation_starts\" [$__auto]))",
          "legendFormat": "sandbox={{sandbox_policy}} approval={{approval_policy}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "approval_policy=never かつ sandbox が緩い組み合わせは bypassPermissions 相当"
    }
  ]
}
