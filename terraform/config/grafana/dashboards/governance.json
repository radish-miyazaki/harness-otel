{
  "uid": "harness-governance",
  "title": "ハーネス / ガバナンス",
  "tags": [
    "harness-otel"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 16,
      "type": "stat",
      "title": "bypassPermissions への遷移（要注意）",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "w": 8,
        "h": 5,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=\"claude-code\"} | event_name=\"permission_mode_changed\" | to_mode=\"bypassPermissions\" [$__range]))",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "colorMode": "background"
      },
      "description": "0 でない場合は経緯を確認する"
    },
    {
      "id": 17,
      "type": "stat",
      "title": "MCP 接続失敗",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "w": 8,
        "h": 5,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=\"claude-code\"} | event_name=\"mcp_server_connection\" | status=\"failed\" [$__range]))",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 18,
      "type": "gauge",
      "title": "編集ツール accept 率",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "w": 8,
        "h": 5,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(claude_code_code_edit_tool_decision_total{decision=\"accept\"}[$__range])) / sum(rate(claude_code_code_edit_tool_decision_total[$__range]))",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 19,
      "type": "barchart",
      "title": "編集ツール判断（decision 別）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (decision) (increase(claude_code_code_edit_tool_decision_total[1d]))",
          "legendFormat": "{{decision}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "判断の出所（source 別）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (source) (increase(claude_code_code_edit_tool_decision_total[1d]))",
          "legendFormat": "{{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "ツール判断イベント（tool_name × decision）",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (tool_name, decision) (count_over_time({service_name=\"claude-code\"} | event_name=\"tool_decision\" [$__auto]))",
          "legendFormat": "{{tool_name}} / {{decision}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Codex 承認結果",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (decision, source) (count_over_time({service_name=\"codex_cli_rs\"} | event_name=\"codex.tool_decision\" [$__auto]))",
          "legendFormat": "{{decision}} / {{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "source=Config は approval_policy による自動判断、User は人が答えたもの"
    },
    {
      "id": 23,
      "type": "logs",
      "title": "読み込まれたプラグイン",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "w": 24,
        "h": 8,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"claude-code\"} | event_name=\"plugin_loaded\"",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
