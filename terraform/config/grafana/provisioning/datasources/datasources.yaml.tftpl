apiVersion: 1

datasources:
  - name: Prometheus
    uid: prometheus
    type: prometheus
    access: proxy
    url: http://${prometheus_host}:9090
    isDefault: true
    editable: false
  - name: Loki
    uid: loki
    type: loki
    access: proxy
    url: http://${loki_host}:3100
    editable: false
%{ if enable_tracing ~}
  - name: Tempo
    uid: tempo
    type: tempo
    access: proxy
    url: http://${tempo_host}:3200
    editable: false
%{ endif ~}
