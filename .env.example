# cp .env.example .env して値を入れる。.env は mise が自動で読み込む
TF_VAR_grafana_admin_password=change-me-to-a-long-passphrase

# OrbStack の場合。Docker MCP サーバーもこの値を DOCKER_HOST として読む
# TF_VAR_docker_host=unix:///Users/<you>/.orbstack/run/docker.sock

# Grafana MCP サーバー用。Grafana で Viewer 権限のサービスアカウントを作りトークンを発行する
# （Administration > Users and access > Service accounts）。要らなければ設定しなくてよい
# GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_xxxxxxxxxxxxxxxx
